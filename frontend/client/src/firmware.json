"# ============================================================================\n#  Grow-zone node \u2014 ESP32-C3-DevKitM-1 on the custom carrier PCB\n#  Copy this file per zone and change `zone` / `zone_label`.\n#\n#  Pin map (matches BUILD-GUIDE.md \u00a74):\n#    GPIO5  I2C SDA      -> SHT45 + PTFE (and SCD-41 if fitted)\n#    GPIO6  I2C SCL\n#    GPIO4  1-Wire data  -> DS18B20 substrate probe (4.7k pullup on PCB)\n#    GPIO7  OUT1         -> humidifier   (via BSS138 low-side driver)\n#    GPIO10 OUT2         -> fan / fresh-air exchange\n#    GPIO3  OUT3         -> heater\n#  Do NOT use GPIO2/8/9 (strapping + BOOT), 18/19 (USB), 20/21 (UART).\n#\n#  Safety model: temperature control runs LOCALLY on this node (thermostat\n#  climate entity). Home Assistant supervises/logs only. Every output is\n#  ALWAYS_OFF on boot, sensor failure drops everything, and each wet/heating\n#  output has a hard maximum on-time. The hardware high-limit thermostat and\n#  thermal cutoff are still mandatory - firmware is the third layer, not the first.\n# ============================================================================\n\nsubstitutions:\n  zone: \"zone1\"\n  zone_label: \"Zone 1\"\n  rh_on: \"92.0\"          # fog below this\n  rh_off: \"96.0\"         # stop fogging at this\n  hum_max_min: \"45\"      # hard ceiling on continuous fogging (minutes)\n  heat_max_min: \"90\"     # hard ceiling on continuous heating (minutes)\n  temp_low: \"20.0\"\n  temp_high: \"24.0\"\n\nesphome:\n  name: grow-${zone}\n  friendly_name: \"Grow ${zone_label}\"\n\nesp32:\n  board: esp32-c3-devkitm-1\n  framework:\n    type: esp-idf\n\nwifi:\n  ssid: !secret wifi_ssid\n  password: !secret wifi_password\n  ap:\n    ssid: \"grow-${zone}-setup\"\n  reboot_timeout: 0s      # never reboot just because the network is down\n\ncaptive_portal:\nlogger:\n  level: INFO\napi:\n  encryption:\n    key: !secret api_key\n  reboot_timeout: 0s      # keep controlling the zone even if HA is offline\nota:\n  - platform: esphome\n    password: !secret ota_password\n\n# ---------------------------------------------------------------- buses\ni2c:\n  id: bus_a\n  sda: GPIO5\n  scl: GPIO6\n  scan: true\n  frequency: 100kHz       # keep the pigtail under ~30-50 cm\n\none_wire:\n  - platform: gpio\n    pin: GPIO4\n\n# ---------------------------------------------------------------- sensors\nsensor:\n  - platform: sht4x\n    address: 0x44\n    update_interval: 30s\n    temperature:\n      name: \"${zone_label} chamber temperature\"\n      id: chamber_temp\n      filters:\n        - median: {window_size: 5, send_every: 5, send_first_at: 3}\n    humidity:\n      name: \"${zone_label} chamber RH\"\n      id: chamber_rh\n      filters:\n        - median: {window_size: 5, send_every: 5, send_first_at: 3}\n\n  - platform: dallas_temp\n    name: \"${zone_label} substrate temperature\"\n    id: substrate_temp\n    update_interval: 30s\n    # resolution: 12   # genuine DS18B20 honours this; most clones ignore it\n\n  # --- CO2 / fresh-air exchange (Tier 2). Uncomment when the SCD-41 is fitted.\n  # - platform: scd4x\n  #   address: 0x62\n  #   update_interval: 30s\n  #   automatic_self_calibration: false   # CRITICAL in a sealed chamber:\n  #       # ASC assumes it sees 400 ppm fresh air weekly and would \"correct\"\n  #       # your high CO2 baseline away. Calibrate manually in outdoor air.\n  #   co2:\n  #     name: \"${zone_label} CO2\"\n  #     id: chamber_co2\n\n  - platform: wifi_signal\n    name: \"${zone_label} WiFi signal\"\n    update_interval: 120s\n  - platform: uptime\n    name: \"${zone_label} uptime\"\n\n# ---------------------------------------------------------------- outputs\nswitch:\n  - platform: gpio\n    pin: GPIO7\n    id: out_humidifier\n    name: \"${zone_label} humidifier\"\n    restore_mode: ALWAYS_OFF\n    on_turn_on:\n      - lambda: 'id(hum_started_ms) = millis();'\n  - platform: gpio\n    pin: GPIO10\n    id: out_fan\n    name: \"${zone_label} fan / FAE\"\n    restore_mode: ALWAYS_OFF\n  - platform: gpio\n    pin: GPIO3\n    id: out_heater\n    name: \"${zone_label} heater\"\n    restore_mode: ALWAYS_OFF\n    on_turn_on:\n      - lambda: 'id(heat_started_ms) = millis();'\n\nglobals:\n  - id: hum_started_ms\n    type: uint32_t\n    restore_value: no\n    initial_value: '0'\n  - id: heat_started_ms\n    type: uint32_t\n    restore_value: no\n    initial_value: '0'\n\n# ---------------------------------------------------------------- local temp control\nclimate:\n  - platform: thermostat\n    name: \"${zone_label} temperature control\"\n    sensor: chamber_temp\n    default_target_temperature_low: ${temp_low}\n    default_target_temperature_high: ${temp_high}\n    heat_action:\n      - switch.turn_on: out_heater\n    cool_action:\n      - switch.turn_on: out_fan\n    idle_action:\n      - switch.turn_off: out_heater\n      - switch.turn_off: out_fan\n    min_heating_off_time: 60s\n    min_heating_run_time: 60s\n    min_cooling_off_time: 60s\n    min_cooling_run_time: 60s\n    min_idle_time: 30s\n    visual:\n      min_temperature: 10\n      max_temperature: 35\n      temperature_step: 0.5\n\n# ---------------------------------------------------------------- supervisory logic\ninterval:\n  - interval: 15s\n    then:\n      - lambda: |-\n          const float rh = id(chamber_rh).state;\n          const float t  = id(chamber_temp).state;\n\n          // 1) Sensor fault -> everything off, raise the alarm.\n          if (std::isnan(rh) || std::isnan(t)) {\n            id(out_humidifier).turn_off();\n            id(out_heater).turn_off();\n            id(out_fan).turn_off();\n            id(sensor_fault).publish_state(true);\n            ESP_LOGW(\"safety\", \"sensor fault: outputs forced off\");\n            return;\n          }\n          id(sensor_fault).publish_state(false);\n\n          // 2) Hard maximum on-times (stuck sensor / open door / welded relay).\n          const uint32_t now = millis();\n          if (id(out_humidifier).state &&\n              (now - id(hum_started_ms)) > (uint32_t)(${hum_max_min} * 60000UL)) {\n            id(out_humidifier).turn_off();\n            id(runtime_trip).publish_state(true);\n            ESP_LOGW(\"safety\", \"humidifier max on-time reached\");\n          }\n          if (id(out_heater).state &&\n              (now - id(heat_started_ms)) > (uint32_t)(${heat_max_min} * 60000UL)) {\n            id(out_heater).turn_off();\n            id(runtime_trip).publish_state(true);\n            ESP_LOGW(\"safety\", \"heater max on-time reached\");\n          }\n\n          // 3) Humidity band control (temperature is handled by the climate entity).\n          if (rh < ${rh_on}) {\n            if (!id(out_humidifier).state) id(out_humidifier).turn_on();\n          } else if (rh > ${rh_off}) {\n            if (id(out_humidifier).state) id(out_humidifier).turn_off();\n          }\n\nbinary_sensor:\n  - platform: template\n    id: sensor_fault\n    name: \"${zone_label} sensor fault\"\n    device_class: problem\n  - platform: template\n    id: runtime_trip\n    name: \"${zone_label} max-runtime trip\"\n    device_class: problem\n  - platform: status\n    name: \"${zone_label} node online\"\n\nbutton:\n  - platform: restart\n    name: \"${zone_label} restart\"\n  - platform: template\n    name: \"${zone_label} clear runtime trip\"\n    on_press:\n      - lambda: 'id(runtime_trip).publish_state(false);'\n\n# ---------------------------------------------------------------------------\n# Optional: SHT4x on-die heater pulse to recover from condensation.\n# Look up the heater command bytes in the Sensirion SHT4x datasheet, then send\n# one over the bus, e.g.:\n#     uint8_t cmd = <heater command>;\n#     id(bus_a).write(0x44, &cmd, 1);\n# Pulse, wait for the die to cool (~1-3 s), then take the reading you log.\n# Never coat or wipe the sensor opening; clean the PTFE membrane per Sensirion's\n# handling instructions.\n# ---------------------------------------------------------------------------\n"