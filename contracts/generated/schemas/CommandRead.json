{
  "$defs": {
    "CommandKind": {
      "enum": [
        "setpoint",
        "actuator",
        "recipe",
        "reboot"
      ],
      "title": "CommandKind",
      "type": "string"
    },
    "CommandState": {
      "enum": [
        "queued",
        "sent",
        "received",
        "applied",
        "failed",
        "expired",
        "rejected_safety"
      ],
      "title": "CommandState",
      "type": "string"
    }
  },
  "properties": {
    "command_id": {
      "title": "Command Id",
      "type": "string"
    },
    "device_id": {
      "title": "Device Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/CommandKind"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/CommandState"
    },
    "attempts": {
      "title": "Attempts",
      "type": "integer"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "sent_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sent At"
    },
    "closed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed At"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "issued_by": {
      "title": "Issued By",
      "type": "string"
    },
    "idempotent_replay": {
      "default": false,
      "title": "Idempotent Replay",
      "type": "boolean"
    }
  },
  "required": [
    "command_id",
    "device_id",
    "kind",
    "payload",
    "idempotency_key",
    "state",
    "attempts",
    "issued_at",
    "expires_at",
    "issued_by"
  ],
  "title": "CommandRead",
  "type": "object"
}
